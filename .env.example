# Webhook de Discord donde se publica el reporte.
# Si se deja vacío, el reporte solo se imprime en consola.
DISCORD_WEBHOOK_URL=

# Timeout de red en segundos (conexión y lectura).
HTTP_TIMEOUT=15

# Nivel de log: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# Opcionales: sobrescriben las URLs de las fuentes.
# BCV_URL=https://www.bcv.org.ve/
# BINANCE_URL=https://p2p.binance.com/bapi/c2c/v2/friendly/c2c/adv/search
